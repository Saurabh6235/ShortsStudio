 "lines": [
  {
   "id": "L01",
   "hi": {
    "tts": "आसमान में दूर बारिश हो रही है… लेकिन रडार को कैसे पता चल जाता है?",
    "cap": [
     "aasmaan mein door",
     "baarish ho rahi hai",
     "lekin radar ko",
     "kaise pata chal jaata hai?"
    ]
   },
   "en": {
    "tts": "Somewhere far away, it's raining in the sky… but how does a radar know?",
    "cap": [
     "somewhere far away",
     "it's raining in the sky",
     "but how does a radar know?"
    ]
   }
  },
  {
   "id": "L02",
   "hi": {
    "tts": "वो बारिश दिख भी नहीं रही, बादलों के पीछे छुपी है, सौ किलोमीटर दूर।",
    "cap": [
     "wo baarish dikh bhi nahi rahi",
     "baadalon ke peeche chhupi hai",
     "100 km door"
    ]
   },
   "en": {
    "tts": "You can't even see that rain. It's hidden behind clouds, a hundred kilometres away.",
    "cap": [
     "you can't even see that rain",
     "it's hidden behind clouds",
     "100 km away"
    ]
   }
  },
  {
   "id": "L03",
   "hi": {
    "tts": "राज़ है, एक ऐसी लहर जो हमें दिखती नहीं, इलेक्ट्रोमैग्नेटिक वेव।",
    "cap": [
     "raaz hai ek aisi lehar",
     "jo humein dikhti nahi",
     "electromagnetic wave"
    ]
   },
   "en": {
    "tts": "The secret is a wave your eyes can't see. An electromagnetic wave.",
    "cap": [
     "the secret is a wave",
     "your eyes can't see",
     "an electromagnetic wave"
    ]
   }
  },
  {
   "id": "L04",
   "hi": {
    "tts": "रडार का एंटीना, माइक्रोवेव की छोटी छोटी पल्स, चारों तरफ़ फेंकता है।",
    "cap": [
     "radar ka antenna",
     "microwave ki chhoti pulses",
     "chaaron taraf phenkta hai"
    ]
   },
   "en": {
    "tts": "A radar antenna fires tiny pulses of microwaves in every direction.",
    "cap": [
     "a radar antenna fires",
     "tiny pulses of microwaves",
     "in every direction"
    ]
   }
  },
  {
   "id": "L05",
   "hi": {
    "tts": "ये लहरें बादल की छोटी बूंदों से निकल जाती हैं, लेकिन बारिश की बड़ी बूंदों से टकराकर वापस लौटती हैं।",
    "cap": [
     "ye lehrein baadal ki",
     "chhoti boondon se nikal jaati hain",
     "lekin baarish ki badi boondon se",
     "takraakar wapas laut-ti hain"
    ]
   },
   "en": {
    "tts": "These waves slip past tiny cloud droplets, but bounce off the bigger raindrops.",
    "cap": [
     "these waves slip past",
     "tiny cloud droplets",
     "but bounce off",
     "the bigger raindrops"
    ]
   }
  },
  {
   "id": "L06",
   "hi": {
    "tts": "जैसे पहाड़ पर आवाज़ की गूंज। इसे कहते हैं रिफ्लेक्शन।",
    "cap": [
     "jaise pahaad par awaaz ki goonj",
     "ise kehte hain reflection"
    ]
   },
   "en": {
    "tts": "Like an echo in the mountains. This is called reflection.",
    "cap": [
     "like an echo in the mountains",
     "this is called reflection"
    ]
   }
  },
  {
   "id": "L07",
   "hi": {
    "tts": "गूंज कितनी देर में लौटी, उससे दूरी पता चलती है।",
    "cap": [
     "goonj kitni der mein lauti",
     "usse doori pata chalti hai"
    ]
   },
   "en": {
    "tts": "How long the echo takes to return tells the distance.",
    "cap": [
     "how long the echo takes",
     "to return",
     "tells the distance"
    ]
   }
  },
  {
   "id": "L08",
   "hi": {
    "tts": "सौ किलोमीटर दूर की बारिश से, जवाब एक मिलीसेकंड से भी कम में आ जाता है।",
    "cap": [
     "100 km door ki baarish se",
     "jawab 1 millisecond se bhi",
     "kam mein aa jaata hai"
    ]
   },
   "en": {
    "tts": "From rain a hundred kilometres away, the echo returns in less than a millisecond.",
    "cap": [
     "from rain 100 km away",
     "the echo returns in",
     "less than a millisecond"
    ]
   }
  },
  {
   "id": "L09",
   "hi": {
    "tts": "और गूंज कितनी तेज़ है, उससे पता चलता है कि बारिश कितनी भारी है।",
    "cap": [
     "aur goonj kitni tez hai",
     "usse pata chalta hai",
     "baarish kitni bhaari hai"
    ]
   },
   "en": {
    "tts": "And how strong the echo is tells how heavy the rain is.",
    "cap": [
     "and how strong the echo is",
     "tells how heavy",
     "the rain is"
    ]
   }
  },
  {
   "id": "L10",
   "hi": {
    "tts": "इसीलिए रडार मैप पर हरा मतलब हल्की बारिश, पीला मध्यम, और लाल मतलब तेज़ बारिश।",
    "cap": [
     "isiliye radar map par",
     "hara matlab halki baarish",
     "peela madhyam",
     "aur laal matlab tez baarish"
    ]
   },
   "en": {
    "tts": "That's why on a radar map, green means light rain, yellow moderate, and red means heavy rain.",
    "cap": [
     "that's why on a radar map",
     "green means light rain",
     "yellow moderate",
     "and red means heavy rain"
    ]
   }
  },
  {
   "id": "L11",
   "hi": {
    "tts": "कंप्यूटर इसी गूंज से, मिलीमीटर प्रति घंटे में बारिश तक नाप लेता है।",
    "cap": [
     "computer isi goonj se",
     "millimeter per ghante mein",
     "baarish tak naap leta hai"
    ]
   },
   "en": {
    "tts": "Computers turn that echo into rainfall, in millimetres per hour.",
    "cap": [
     "computers turn that echo",
     "into rainfall",
     "in millimetres per hour"
    ]
   }
  },
  {
   "id": "L12",
   "hi": {
    "tts": "पर असली जादू है, डॉप्लर इफ़ेक्ट।",
    "cap": [
     "par asli jaadu hai",
     "doppler effect"
    ]
   },
   "en": {
    "tts": "But the real magic is the Doppler effect.",
    "cap": [
     "but the real magic is",
     "the doppler effect"
    ]
   }
  },
  {
   "id": "L13",
   "hi": {
    "tts": "एम्बुलेंस पास आती है तो साइरन की आवाज़ ऊँची लगती है, दूर जाती है तो नीची।",
    "cap": [
     "ambulance paas aati hai",
     "to siren ki awaaz oonchi lagti hai",
     "door jaati hai to neechi"
    ]
   },
   "en": {
    "tts": "When an ambulance comes closer, its siren sounds higher. As it moves away, lower.",
    "cap": [
     "when an ambulance comes closer",
     "its siren sounds higher",
     "as it moves away, lower"
    ]
   }
  },
  {
   "id": "L14",
   "hi": {
    "tts": "बारिश की बूंदें भी, लौटती लहर की फ़्रीक्वेंसी थोड़ी बदल देती हैं।",
    "cap": [
     "baarish ki boondein bhi",
     "lautti lehar ki frequency",
     "thodi badal deti hain"
    ]
   },
   "en": {
    "tts": "Moving raindrops also shift the frequency of the returning wave, just a little.",
    "cap": [
     "moving raindrops also shift",
     "the frequency of the returning wave",
     "just a little"
    ]
   }
  },
  {
   "id": "L15",
   "hi": {
    "tts": "इससे रडार जान लेता है, कि बारिश हमारी तरफ़ आ रही है या दूर जा रही है, और कितनी तेज़।",
    "cap": [
     "isse radar jaan leta hai",
     "ki baarish humari taraf aa rahi hai",
     "ya door ja rahi hai",
     "aur kitni tez"
    ]
   },
   "en": {
    "tts": "So the radar knows whether the rain is coming toward us or moving away, and how fast.",
    "cap": [
     "so the radar knows",
     "whether the rain is coming toward us",
     "or moving away",
     "and how fast"
    ]
   }
  },
  {
   "id": "L16",
   "hi": {
    "tts": "और अगर पास पास, एक तरफ़ बूंदें आ रही हों और दूसरी तरफ़ जा रही हों,",
    "cap": [
     "aur agar paas paas",
     "ek taraf boondein aa rahi hon",
     "aur doosri taraf ja rahi hon"
    ]
   },
   "en": {
    "tts": "And if, side by side, drops rush in on one side and away on the other,",
    "cap": [
     "and if side by side",
     "drops rush in on one side",
     "and away on the other"
    ]
   }
  },
  {
   "id": "L17",
   "hi": {
    "tts": "तो मतलब तूफ़ान घूम रहा है। यहीं से टॉर्नेडो जैसे घूमते तूफ़ानों की चेतावनी मिलती है।",
    "cap": [
     "to matlab toofaan ghoom raha hai",
     "yahin se tornado jaise",
     "ghoomte toofaanon ki chetavani milti hai"
    ]
   },
   "en": {
    "tts": "the storm is rotating. That's how forecasters spot tornado-like spinning storms.",
    "cap": [
     "the storm is rotating",
     "that's how forecasters spot",
     "tornado-like spinning storms"
    ]
   }
  },
  {
   "id": "L18",
   "hi": {
    "tts": "यानी बारिश आप तक पहुँचे, उससे पहले ही, रडार उसकी गूंज सुन चुका होता है।",
    "cap": [
     "yaani baarish aap tak pahunche",
     "usse pehle hi",
     "radar uski goonj sun chuka hota hai"
    ]
   },
   "en": {
    "tts": "So before the rain ever reaches you, the radar has already heard its echo.",
    "cap": [
     "so before the rain",
     "ever reaches you",
     "the radar has already heard its echo"
    ]
   }
  },
  {
   "id": "L19",
   "hi": {
    "tts": "ऐसी ही कॉन्सेप्चुअल क्लैरिटी के लिए, सब्सक्राइब करें मेरिट मंत्रा।",
    "cap": [
     "aisi hi conceptual clarity ke liye",
     "subscribe karein merit mantra"
    ]
   },
   "en": {
    "tts": "For more conceptual clarity like this, subscribe to Merit Mantra.",
    "cap": [
     "for more conceptual clarity like this",
     "subscribe to merit mantra"
    ]
   }
  }
